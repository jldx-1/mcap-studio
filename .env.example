# Both npm and just commands load .env when present.
MCAP_HOST=127.0.0.1
MCAP_BACKEND_PORT=8000
MCAP_FRONTEND_PORT=5173

# Optional: API destination when the Vite frontend runs on a different host.
# Leave unset when frontend and backend run together.
# On the backend, allow the browser-facing frontend origin in MCAP_ALLOWED_ORIGINS.
# MCAP_API_PROXY_TARGET=http://backend-host:8000

# Maximum size of each uploaded MCAP, in GiB (1 GiB = 1,073,741,824 bytes).
# Default: 64. Set 0 for unlimited. Restart the backend after changing.
MCAP_UPLOAD_LIMIT_GIB=64

# Optional: directory used to discover existing projects and store new projects.
# Default is this repository. Use an absolute path when overriding it.
# MCAP_WORKSPACE=/path/to/your/workspace

# Optional: directory containing a production React build.
# MCAP_FRONTEND_DIR=/path/to/frontend/dist

# For an HTTPS deployment, send session cookies only over HTTPS.
# MCAP_SECURE_COOKIES=1
# Trusted browser origins for separate frontend deployments (comma-separated).
# Include the browser-facing origin when using the Vite proxy from another host.
# MCAP_ALLOWED_ORIGINS=https://your-workspace.example
